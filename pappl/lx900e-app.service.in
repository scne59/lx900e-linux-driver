[Unit]
Description=Primera LX900e printer application
Documentation=man:lx900e-app(1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lp
Group=lp
StateDirectory=lx900e-app
# CUPS puts its self-signed TLS certificate under $HOME/.cups/ssl.  Without a
# writable HOME, IPPS clients fail with "Server credentials not set".
Environment=HOME=/var/lib/lx900e-app
WorkingDirectory=/var/lib/lx900e-app
# The device arguments are filled in by `make pappl` / `make install-pappl`
# when a printer is connected.  With no printer the application discovers one when it starts.
ExecStart=@BINDIR@/lx900e-app@DEVICE_ARGS@ --port @PORT@ --spool /var/lib/lx900e-app
Restart=on-failure
RestartSec=2

# To bind a different printer, override ExecStart with:
#   sudo systemctl edit lx900e-app
#
# [Service]
# ExecStart=
# ExecStart=@BINDIR@/lx900e-app \
#     --device 'usb://Primera/Color_Label_900?serial=00000001' \
#     --printer LX900e --port @PORT@ --spool /var/lib/lx900e-app
#
# Find the URI (including the serial number) with:
#   lx900e-app --detect
#   lx900e-app --list-devices
#
# If the printer is not accessible as user "lp", run
#   lx900e-app --device 'usb://Primera/Color_Label_900?serial=00000001' \
#              --check-device
# and adjust the service user or the udev permissions.

[Install]
WantedBy=multi-user.target
